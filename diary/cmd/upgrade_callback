#!/bin/bash
set -u

# 这些路径变量由飞牛注入；万一某个是空的，拼出来的路径会退到根目录导致 mkdir 失败，
# 所以统一留一份和 /var/apps/<应用名>/ 一致的兜底值。
PKGHOME="${TRIM_PKGHOME:-/var/apps/diary/home}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/diary/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/diary/target}"

# 更新会把 target 重新解包成 root 所有，服务降权运行前要改回应用用户
PKG_USER="${TRIM_USERNAME:-diary}"
PKG_GROUP="${TRIM_GROUPNAME:-diary}"

echo "日记本已更新到 ${TRIM_APPVER:-未知版本}。" >>"${PKGVAR}/app.log" 2>/dev/null || true

if [ "$(id -u)" -eq 0 ]; then
  chown -R "${PKG_USER}:${PKG_GROUP}" "${APPDEST}" 2>/dev/null || true
  chown -R "${PKG_USER}:${PKG_GROUP}" "${PKGVAR}" 2>/dev/null || true
fi

exit 0
